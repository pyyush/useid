{
  "name": "@pyyush/useid",
  "version": "1.0.0-rc.1",
  "description": "uSEID - Universal Semantic Element ID for stable cross-run element identity",
  "author": "Piyush Vyas",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pyyush/useid.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:verify": "node scripts/check-release-policy.mjs && npm run build && npm run typecheck && npm test && npm test -- src/__tests__/performance-budget.test.ts && npm audit --json && npm pack --dry-run >/dev/null",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "element-identity",
    "browser-agent",
    "accessibility",
    "aria",
    "selector",
    "stable-ref",
    "e2e",
    "playwright",
    "cdp",
    "dom"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
